require(tidyverse)
require(ggVennDiagram)
setwd("/Users/jennenwosu/Documents/ROCCA_Military_Interventions")
# Chunk 3
lang_list_full <- read_csv('hoss/data/lang_list_full.csv')
colnames(lang_list_full)[1] <- 'country'
wiki_lang <- read_csv('hoss/data/df_lang.csv')
country_separated <- read_csv('hoss/data/country_separated.csv')
country_separated <- country_separated %>%
filter(country==1)
# Chunk 4
make_venn <- function(oper_name){
oper_countries <- country_separated %>%
filter(operation==oper_name)
oper_wiki_lang <- wiki_lang %>%
filter(wikidata_name==oper_name)
actual_langs <- sort(oper_wiki_lang$lang_key)
expected_langs <- lang_list_full %>%
filter(str_detect(country, str_c(oper_countries$country_name, collapse = "|")))
expected_langs <- sort(unique(unlist(strsplit(paste0(expected_langs$languages,collapse='', sep=", "),", "))))
print("Expect a page:")
print(expected_langs)
print("Have a page:")
print(actual_langs)
venn_list <- list(expected = expected_langs,
actual = actual_langs)
venn <- Venn(venn_list)
data <- process_data(venn)
print(venn_setlabel(data)$Y)
return(
ggplot() +
# 1. region count layer
geom_polygon(aes(X, Y, fill = count, group = id),
data = venn_regionedge(data)) +
# 2. set edge layer
geom_path(aes(X, Y, color = id, group = id),
data = venn_setedge(data),
show.legend = FALSE) +
# 3. set label layer
geom_text(aes(X, Y, label = c('Participant language', 'Represented in Wikipedia')),
data = venn_setlabel(data), hjust = ifelse(venn_setlabel(data)$Y > 3, 0.75, 0.25)) +
# 4. region label layer
geom_label(aes(X, Y, label = count),
data = venn_regionlabel(data)) +
coord_equal() +
scale_x_continuous(expand = expansion(mult = .5)) +  scale_fill_distiller(trans = 'reverse')+labs(title = sprintf("%s: \n Languages with Wikipedia coverage vs. \n participants' primary languages", oper_name))+
theme_void() +
theme(plot.title.position = 'plot', plot.title = element_text(hjust = 0.5, vjust = -15),legend.position="none", )+
scale_y_reverse() +
coord_flip()
)
}
